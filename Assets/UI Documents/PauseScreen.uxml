<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="PauseCanvas" style="flex-grow: 1; align-items: center; background-color: rgba(55, 55, 55, 0.82); width: 100%; height: 100%;">
        <ui:VisualElement name="ButtonsArea" style="width: 500px; height: 500px; margin-top: 300px; margin-bottom: 300px; background-color: rgb(231, 231, 231); border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px;">
            <ui:Label tabindex="-1" text="Pausa!" parse-escape-sequences="true" display-tooltip-when-elided="true" name="PauseTitle" style="margin-top: 36px; margin-left: 36px; margin-right: 36px; margin-bottom: 24px; align-self: center; justify-content: center; align-items: center; font-size: 40px; color: rgb(0, 108, 176); -unity-text-align: middle-center;" />
            <ui:Button text="Continuar" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ContinueButton" style="margin-right: 48px; margin-left: 48px; margin-top: 24px; margin-bottom: 16px; background-color: rgb(0, 108, 176); color: rgb(255, 255, 255); border-left-color: rgb(54, 152, 214); border-right-color: rgb(54, 152, 214); border-top-color: rgb(54, 152, 214); border-bottom-color: rgb(54, 152, 214); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 28px;" />
            <ui:Button text="Reiniciar" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RestartButton" style="margin-right: 48px; margin-left: 48px; margin-top: 12px; margin-bottom: 12px; background-color: rgb(0, 108, 176); color: rgb(255, 255, 255); border-left-color: rgb(54, 152, 214); border-right-color: rgb(54, 152, 214); border-top-color: rgb(54, 152, 214); border-bottom-color: rgb(54, 152, 214); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 28px;" />
            <ui:Button text="Voltar ao menu" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackToMenuButton" style="margin-right: 48px; margin-left: 48px; margin-top: 16px; margin-bottom: 24px; background-color: rgb(0, 108, 176); color: rgb(255, 255, 255); border-left-color: rgb(54, 152, 214); border-right-color: rgb(54, 152, 214); border-top-color: rgb(54, 152, 214); border-bottom-color: rgb(54, 152, 214); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 28px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
